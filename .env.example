# ==============================================================================
# 📦 STOCKPILOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Database Configuration
POSTGRES_DB=stockpilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
DATABASE_URL=postgresql://postgres:your_strong_postgres_password_here@postgres:5432/stockpilot

# 2. LLM Provider API Keys (Chọn ít nhất 1 nhà cung cấp)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 3. Server Ports
CHAT_HOST_PORT=8000

# 4. pgAdmin (Tùy chọn khi bật profile 'tools')
PGADMIN_EMAIL=admin@stockpilot.local
PGADMIN_PASSWORD=your_pgadmin_password_here
